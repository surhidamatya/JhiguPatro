 "_comment": "SMS templates, renderer, segments and scheduler (guide section 13). Expected values from an independent Python model (own GSM table, regex renderer) or derived by hand; not from a carrier or provider. Scheduler times are minutes after baseUtcMs, the UTC instant of BS 2082-05-10 09:00 Nepal time (UTC+05:45); baseUtcMs was computed from data/nepali_calendar_data.json. Scheduler defaults: back-off [1,5,30] min, maxAttempts 4, BAD_NUMBER is permanent. failures maps a reminder id to the error codes of its successive gateway attempts.",
 "baseUtcMs": 1756178100000,
 "render": [
  {
   "name": "simple",
   "text": "Hello {name}",
   "values": {
    "name": "Ram"
   },
   "strict": true,
   "expect": {
    "text": "Hello Ram"
   }
  },
  {
   "name": "repeated key",
   "text": "{a}-{a}-{b}",
   "values": {
    "a": "x",
    "b": 2
   },
   "strict": true,
   "expect": {
    "text": "x-x-2"
   }
  },
  {
   "name": "number value",
   "text": "Rs {n}",
   "values": {
    "n": 1500
   },
   "strict": true,
   "expect": {
    "text": "Rs 1500"
   }
  },
  {
   "name": "zero number is a value",
   "text": "n={n}",
   "values": {
    "n": 0
   },
   "strict": true,
   "expect": {
    "text": "n=0"
   }
  },
  {
   "name": "empty string is a value",
   "text": "[{a}]",
   "values": {
    "a": ""
   },
   "strict": true,
   "expect": {
    "text": "[]"
   }
  },
  {
   "name": "missing strict",
   "text": "Hi {name}, {x}",
   "values": {
    "name": "A"
   },
   "strict": true,
   "expect": {
    "error": "MISSING_VALUE",
    "key": "x"
   }
  },
  {
   "name": "missing lenient",
   "text": "Hi {name}, {x}!",
   "values": {
    "name": "A"
   },
   "strict": false,
   "expect": {
    "text": "Hi A, !"
   }
  },
  {
   "name": "null is missing",
   "text": "Hi {a}",
   "values": {
    "a": null
   },
   "strict": true,
   "expect": {
    "error": "MISSING_VALUE",
    "key": "a"
   }
  },
  {
   "name": "extra values ignored",
   "text": "Hi {a}",
   "values": {
    "a": "1",
    "b": "2"
   },
   "strict": true,
   "expect": {
    "text": "Hi 1"
   }
  },
  {
   "name": "value not re-expanded",
   "text": "{a} {b}",
   "values": {
    "a": "{b}",
    "b": "B"
   },
   "strict": true,
   "expect": {
    "text": "{b} B"
   }
  },
  {
   "name": "lone braces kept",
   "text": "{ } {} {a b} {a}",
   "values": {
    "a": "1"
   },
   "strict": true,
   "expect": {
    "text": "{ } {} {a b} 1"
   }
  },
  {
   "name": "no placeholders",
   "text": "plain text",
   "values": {},
   "strict": true,
   "expect": {
    "text": "plain text"
   }
  },
  {
   "name": "devanagari value",
   "text": "नाम: {n}",
   "values": {
    "n": "राम"
   },
   "strict": true,
   "expect": {
    "text": "नाम: राम"
   }
  },
  {
   "name": "adjacent",
   "text": "{a}{b}",
   "values": {
    "a": "1",
    "b": "2"
   },
   "strict": true,
   "expect": {
    "text": "12"
   }
  },
  {
   "name": "underscore and digits",
   "text": "{a_1}",
   "values": {
    "a_1": "v"
   },
   "strict": true,
   "expect": {
    "text": "v"
   }
  },
  {
   "name": "non ascii key not a placeholder",
   "text": "{नाम}",
   "values": {},
   "strict": true,
   "expect": {
    "text": "{नाम}"
   }
  }
