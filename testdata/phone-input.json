  {
   "name": "mobile as it is typed",
   "init": {},
   "steps": [
    {
     "action": "input",
     "text": "9",
     "caret": 1,
     "expect": {
      "text": "9",
      "caret": 1,
      "valid": false,
      "error": null,
      "carrier": null,
      "type": null
     }
    },
    {
     "action": "input",
     "text": "98",
     "caret": 2,
     "expect": {
      "text": "98",
      "caret": 2,
      "type": null
     }
    },
    {
     "action": "input",
     "text": "984",
     "caret": 3,
     "expect": {
      "text": "984",
      "caret": 3,
      "carrier": "NTC",
      "type": "mobile",
      "error": null
     }
    },
    {
     "action": "input",
     "text": "9841",
     "caret": 4,
     "expect": {
      "text": "984-1",
      "caret": 5
     }
    },
    {
     "action": "input",
     "text": "98412",
     "caret": 5,
     "expect": {
      "text": "984-12",
      "caret": 6
     }
    }
   ]
  },
